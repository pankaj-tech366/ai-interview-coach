# Groq API key (get one at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq model id. llama-3.3-70b-versatile is not available on every Groq account/region;
# openai/gpt-oss-120b is used as a widely-available default. Change if your account has access.
GROQ_MODEL=openai/gpt-oss-120b

# Comma separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000
